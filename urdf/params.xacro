<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- ****************** ROBOT DIMENSIONS ****************** -->
  <!-- Units: meters, degrees, kg, N*m, m/s2 -->
  <!-- oomwoo-one (forked from Proscenic M6 Pro): round body 349mm dia, ~95mm tall (incl. LiDAR turret).
       Geometry inherited — refine from the sourced parts + 3D design. -->
  <!-- wheel_base = measured wheel track 235mm. The bridge uses its own odometry
       constant WHEEL_BASE = 0.233m (2mm less); negligible, calibrate empirically. -->
  <xacro:property name="wheel_diameter" value="0.068"/>
  <xacro:property name="wheel_width" value="0.012"/>
  <xacro:property name="caster_diameter" value="0.025"/>
  <!-- Caster center to base edge -->
  <xacro:property name="caster_inset" value="0.030"/>
  <xacro:property name="floor_clearance" value="0.0125"/>
  <xacro:property name="base_diameter" value="0.349"/>
  <xacro:property name="wheel_base" value="0.235"/>
  <!-- Body cylinder: top is 79mm above the floor, minus 12.5mm floor gap = 66.5mm tall.
       LiDAR housing sits on top (body top 79mm + 18mm housing = ~97mm total height). -->
  <xacro:property name="lower_cylinder_height" value="0.0665"/>
  <!-- LiDAR housing, measured 18mm, seated flush on the body top -->
  <xacro:property name="laser_puck_height" value="0.018"/>
  <xacro:property name="laser_puck_diameter" value="0.083"/>
  <!-- offset = laser_puck_height/2 so the housing bottom sits at the body top -->
  <xacro:property name="laser_puck_offset" value="0.009"/>
  <!-- oomwoo-one: the LiDAR turret is CENTERED on top of the round body (offset = 0),
       unlike the Proscenic M6 Pro this was forked from (whose LiDAR sat ~96.5mm rearward). -->
  <xacro:property name="lidar_center_offset" value="0.0"/>

  <!-- N*m -->
  <xacro:property name="motor_stall_torque" value="0.5"/>
  <xacro:property name="max_linear_acceleration" value="1"/>
  <xacro:property name="lower_cylinder_mass" value="2.500"/>
  <!-- caster and battery weight -->
  <xacro:property name="caster_mass" value="0.050"/>
  <xacro:property name="wheel_mass" value="0.100"/>
  <xacro:property name="laser_puck_mass" value="0.150"/>
  <!-- ****************** **************** ****************** -->

  <!-- Front bumper = the front 180 deg of the body's cylindrical wall, modelled as
       a continuous faceted arc. Left half spans 0..+90 deg, right half -90..0 deg
       (they meet at the front, 0 deg, so there is no dead-center gap). Each half is
       'bumper_facets_per_side' thin box facets, named so the contact sensors can
       reference them; facets sit at the body radius and protrude a few mm so they
       are the surface that touches obstacles. -->
  <xacro:property name="bumper_facets_per_side" value="6"/>
  <xacro:property name="bumper_thickness" value="0.010"/> <!-- radial; outer face ~5mm proud -->
  <!-- Bumper spans the FULL body cylinder height, centered on it (like a consumer
       vacuum), so a low ledge the body can hit (e.g. a bookcase bottom shelf)
       always contacts the bumper instead of wedging in the gap above or below it.
       Derived from lower_cylinder_height so the two can never drift apart. -->
  <xacro:property name="bumper_height" value="${lower_cylinder_height}"/>
  <xacro:property name="bumper_z" value="${lower_cylinder_height/2}"/>  <!-- = body cylinder center, base_link frame -->

  <!-- ****************** SIDE DISTANCE SENSORS ****************** -->
  <!-- Left/right short-range wall sensors. Modelled as a single-ray gpu_lidar
       (gz-sim has no native Range/ToF sensor) aimed straight out to the side,
       perpendicular to forward, at the body's mid-height on each side edge. That
       aim reads the wall distance directly abeam, the basis for distance-keeping
       wall following. On the physical robot this maps to a ToF (sensor_msgs/Range);
       in sim it is a 1-beam sensor_msgs/LaserScan. All values below are tunable. -->
  <xacro:property name="range_sensor_min" value="0.02"/>          <!-- m: closest reading -->
  <xacro:property name="range_sensor_max" value="0.50"/>          <!-- m: beyond this reads as no wall -->
  <xacro:property name="range_sensor_resolution" value="0.005"/>  <!-- m -->
  <xacro:property name="range_sensor_angle_deg" value="90.0"/>    <!-- deg from forward; 90 = straight out to the side -->
  <xacro:property name="range_sensor_x" value="0.0"/>             <!-- fore/aft mount offset along the side -->
  <xacro:property name="range_sensor_z" value="${lower_cylinder_height/2}"/> <!-- body mid-height, base_link frame -->
  <xacro:property name="range_sensor_update_rate" value="20"/>    <!-- Hz -->
  <xacro:property name="range_sensor_size" value="0.012"/>        <!-- visual cube edge (m) -->
  <xacro:property name="range_sensor_mass" value="0.005"/>        <!-- kg, negligible -->
  <!-- gz-sim's gpu_lidar needs 2 or more samples: angle_step = (max-min)/(samples-1),
       so samples=1 divides by zero (angle_step = NaN, the ray never fires). Model
       the beam as a narrow few-sample cone instead, like a real ToF's small field
       of view; a consumer takes the nearest (min) range as THE distance. -->
  <xacro:property name="range_sensor_samples" value="3"/>         <!-- rays across the FOV (2 or more) -->
  <xacro:property name="range_sensor_fov_deg" value="1.0"/>       <!-- total beam FOV (deg) -->

  <xacro:property name="DEG2RAD" value="0.0174533"/>
</robot>
